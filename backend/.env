# RepoQuest Environment Configuration
PROJECT_NAME="RepoQuest"
PROJECT_VERSION="1.0.0"

# Ollama Local AI Configuration
# Defaulting to Qwen 2.5 7B Instruct
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
OLLAMA_TIMEOUT_SECONDS=60.0

# Optional GitHub Token to increase rate limits (60/hr -> 5000/hr)
# Not required for public repositories
GITHUB_TOKEN=""

# Persistence
DATABASE_PATH="repoquest.db"
