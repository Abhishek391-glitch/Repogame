# RepoQuest Environment Configuration Example
PROJECT_NAME="RepoQuest"
PROJECT_VERSION="1.0.0"

# Ollama Local AI Configuration (Qwen 2.5 7B Instruct)
OLLAMA_BASE_URL="http://localhost:11434"
